# ============================================================
# clawbot-dev-assistant 配置文件
# install.sh 会复制成 .env；推荐用向导填写：.venv/bin/python -m devbot setup
# .env 里是密钥，不要提交到 Git。格式 KEY=VALUE，等号两边不要空格，值不用加引号。
# ============================================================

# ---- 必填：DeepSeek（https://platform.deepseek.com → API keys）----
DEEPSEEK_KEY=
# 模型名以 DeepSeek 官方文档为准；python -m devbot check 会显示实际响应的模型
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：disabled 关闭（快，推荐）、enabled 开启（慢、贵）、留空不传参数（用 deepseek-chat 等旧模型名时留空）
DEEPSEEK_THINKING=disabled
# 联网搜索（DeepSeek Search API，同一个 Key，按次计费）。不需要就改成 0
SEARCH_ENABLED=1
# DeepSeek 余额低于多少元时提醒你
ALERT_BALANCE=5

# ---- 每日 GitHub 热榜 ----
# 推送时间（24 小时制）。建议 9 点前：DeepSeek 如果还在实行白天高峰加价，早上生成更便宜
REPORT_TIME=07:40
# 综合榜条数、嵌入式精选条数
TOP_N=10
EMBEDDED_N=3
# 你的关注方向：嵌入式精选会优先挑和这些相关的（在微信里也能改：「关注 RK3588」）
INTERESTS=Rockchip,RK3506,RV1126,ESP32,STM32,Zephyr,RTOS,CAN,MIPI CSI,Linux驱动,KiCad,嘉立创EDA
# 嵌入式候选来源：这些语言的今日趋势 + 带这些标签/关键词的近期新项目
EMBEDDED_LANGS=c,c++,rust,assembly
EMBEDDED_TOPICS=embedded,firmware,microcontroller,rtos,zephyr,esp32,stm32,rp2040,riscv,kicad,pcb,linux-kernel,device-driver,can-bus,fpga
# 可选：GitHub Token（Settings → Developer settings → Fine-grained tokens，不用勾任何权限）
# 不填也能用（每小时 60 次 API 额度），填了是 5000 次
GITHUB_TOKEN=

# ---- 可选：Memos 笔记同步（「记一下」「收藏 3」会同时存一份到你的 Memos）----
# 同一台服务器上的 Memos 可以填 http://127.0.0.1:5230（端口按你 1Panel 里的映射）
MEMOS_URL=
MEMOS_TOKEN=

# ---- 服务器看门狗 ----
# 可选：这些 systemd 服务停了/恢复了会通知你（逗号分隔，留空不监视）。比如 WATCH_SERVICES=nginx,docker
WATCH_SERVICES=
# 磁盘使用率超过多少提醒
DISK_ALERT_PERCENT=90

# ---- 微信 ClawBot ----
# 只回复扫码绑定的那个人（就是你）。确认是本人却被日志提示"忽略"时改成 0
ILINK_ONLY_OWNER=1
# 主动推送窗口（小时）：你最后一次发消息约 24 小时后，微信就不允许主动推送；默认 23 留余量
ILINK_PUSH_WINDOW_HOURS=23

# ---- 其他 ----
BOT_NAME=小码
BOT_TIMEZONE=Asia/Shanghai
# 数据目录（数据库、ClawBot 登录凭据、备份），默认是项目下的 data/
# DATA_DIR=
